# Platform Console Environment Variables
# TanStack Start API routes read backend URLs at runtime on the server.
# The same Docker image can be configured for multiple environments.

# CMS Service Base URL (service root — CMS admin endpoints are under /admin/*)
# Production: https://cms.salehspace.dev
CMS_BASE_URL=http://localhost:8080

# IAM Authorization Service Base URL (service root — IAM endpoints are under /api/v1/*)
# Production: https://iam.salehspace.dev
IAM_BASE_URL=http://localhost:4003

# Aggregation Service Base URL
# Production: https://wahb-broker.salehspace.dev
AGGREGATION_BASE_URL=http://localhost:5002

# Enrichment Service Base URL (used by System Health tab)
ENRICHMENT_BASE_URL=http://localhost:5050

# Enrichment service-to-service bearer token (used to call /v1/admin/restart
# from the System Health tab). Must match Enrichment's dedicated restart capability.
ENRICHMENT_RESTART_TOKEN=

# Media Service Base URL (used by System Health tab — whisper/clip models +
# arq async-transcription worker/queue). Production: Media's internal Cranl URL.
MEDIA_BASE_URL=http://localhost:5051

# Wahb-Platform (frontend) Base URL — pinged for liveness by System Health tab
# Production: https://wahb.salehspace.dev
PLATFORM_BASE_URL=http://localhost:3000

# Independent migration coordinator (read-only cockpit credential).
MIGRATION_COORDINATOR_URL=http://localhost:5090
MIGRATION_COORDINATOR_READ_TOKEN=

# Grafana URL for deep observability links (public value supplied at runtime)
# Production: https://grafana.salehspace.dev
GRAFANA_URL=http://localhost:3002
